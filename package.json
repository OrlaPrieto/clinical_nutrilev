{
  "name": "clinical-nutrilev",
  "version": "1.0.5",
  "private": true,
  "workspaces": [
    "apps/frontend",
    "apps/api-main"
  ],
  "scripts": {
    "build": "node set-env.js && npm run build --workspace=apps/frontend && rm -rf dist && mkdir -p dist && cp -R apps/frontend/dist/* dist/",
    "start": "concurrently \"npm run start:frontend\" \"npm run start:api-main\" \"npm run start:api-python\"",
    "start:frontend": "npm run start --workspace=apps/frontend",
    "start:api-main": "npm run start:dev --workspace=apps/api-main",
    "start:api-python": "python3 apps/api-python/app.py",
    "install:all": "npm install && npm install --workspace=apps/frontend && npm install --workspace=apps/api-main",
    "test": "npm test --workspaces"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "dependencies": {
    "@angular/animations": "^21.2.25",
    "@angular/cdk": "^21.2.14",
    "@angular/common": "^21.2.25",
    "@angular/compiler": "^21.2.25",
    "@angular/core": "^21.2.25",
    "@angular/forms": "^21.2.25",
    "@angular/material": "^21.2.14",
    "@angular/platform-browser": "^21.2.25",
    "@angular/platform-browser-dynamic": "^21.2.25",
    "@angular/router": "^21.2.25",
    "@angular/service-worker": "^21.2.25",
    "html-to-image": "^1.11.13"
  },
  "overrides": {
    "axios": "^1.20.0",
    "dompurify": "^3.4.16",
    "undici": "^7.30.0",
    "multer": "2.4.0",
    "@nestjs/platform-express": {
      "multer": "2.4.0"
    },
    "fast-uri": "^3.1.8",
    "http-cache-semantics": "^4.3.0",
    "postcss-selector-parser": "^7.1.6",
    "piscina": "^5.3.2",
    "proxy-addr": "^2.0.8",
    "shell-quote": "^1.12.0",
    "source-map-js": "^1.2.2",
    "ip-address": "^10.7.3",
    "js-yaml": "^4.1.0",
    "argparse": "^2.0.1"
  }
}
